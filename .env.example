# Copy to .env and fill locally. Never commit real secrets.
# Public StatCan / BoC endpoints need no API keys for v1; placeholders for later config.

NOWCASTER_ENV=development
RAW_STORE_PATH=data/raw.duckdb
LOG_LEVEL=INFO

# Optional overrides (leave blank to use package defaults)
STATCAN_BASE_URL=
BOC_VALET_BASE_URL=
