# Copy to .env and fill locally. Never commit real secrets.
# Public StatCan / BoC endpoints need no API keys for v1; placeholders for later config.

NOWCASTER_ENV=development
RAW_STORE_PATH=data/raw.duckdb
LOG_LEVEL=INFO

# HTTP cache for ingest (1=on). Keeps tests/dev from hammering StatCan/Valet.
NOWCASTER_HTTP_CACHE=1
NOWCASTER_CACHE_DIR=data/cache/http

# Optional overrides (leave blank to use package defaults)
STATCAN_BASE_URL=
BOC_VALET_BASE_URL=

# Dashboard / live logs (CSV or Parquet). Empty → Streamlit uses bundled fixtures.
NOWCASTER_PREDICTION_LOG=data/logs/predictions.csv
NOWCASTER_SCORE_LOG=data/logs/scores.csv
NOWCASTER_DASHBOARD_META=data/logs/dashboard_meta.json
NOWCASTER_PRODUCTION_MODEL=ar1
NOWCASTER_BASELINE_MODEL=last_value
